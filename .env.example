# Copy this file to .env.local and replace every placeholder with your own values.
# Do not commit real credentials or generated secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=IFTA Consulting Client Portal
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-your-vapid-public-key
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/ifta
AUTH_SESSION_DAYS=14
EMAIL_VERIFICATION_TOKEN_HOURS=24
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-one-time-seed-password

# Authentication
PASSWORD_PEPPER=replace-with-a-long-random-value

# QStash background jobs
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=replace-with-your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=replace-with-your-current-qstash-signing-key
QSTASH_NEXT_SIGNING_KEY=replace-with-your-next-qstash-signing-key

# Encryption and signed webhooks
ENCRYPTION_KEY=replace-with-a-32-byte-encryption-key
WEBHOOK_SIGNING_SECRET=replace-with-your-webhook-provider-signing-secret
VAPID_PRIVATE_KEY=replace-with-your-vapid-private-key
VAPID_SUBJECT=mailto:notifications@example.com

# Optional AI, email, and document-storage services
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
GMAIL_SMTP_USER=your-google-account@gmail.com
GMAIL_SMTP_APP_PASSWORD=replace-with-a-google-app-password


# SMS notifications (Africa's Talking). Leave blank to disable SMS; use AT_USERNAME=sandbox to test.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Leave blank for Cloudflare R2. Do not use the public *.r2.dev delivery URL.
R2_ENDPOINT=

# KRA eTIMS (fiscal invoicing). Fill these in and the portal talks to KRA; nothing else to set up.
#   1. Choose the mode:   OSCU = online, hosted by KRA   |   VSCU = KRA's VSCU app running on your own server
#   2. Set the endpoint URL and your KRA PIN.
#   3. OSCU only: set the device serial, run `npm run etims:init`, and paste the key it prints into ETIMS_CMC_KEY.
#   4. Register your services with KRA once:  npm run etims:register-items
ETIMS_MODE=
# SANDBOX while testing with KRA, PRODUCTION when you go live
ETIMS_ENVIRONMENT=SANDBOX
# OSCU sandbox: https://etims-api-sbx.kra.go.ke/etims-api   |   VSCU: http://localhost:8088 (wherever your VSCU runs)
ETIMS_BASE_URL=
ETIMS_TIN=
# 00 is the head office
ETIMS_BRANCH_ID=00
ETIMS_DEVICE_SERIAL=
ETIMS_CMC_KEY=
# Set to false to pause fiscal submission without removing the settings above
ETIMS_ENABLED=true
# If you already issued invoices under this PIN elsewhere, continue the numbering from here (default 1)
ETIMS_SEQUENCE_START=1
# Endpoint paths default correctly for each mode. Override only if KRA gives you different ones:
# ETIMS_PATH_INIT=
# ETIMS_PATH_SALES=
# ETIMS_PATH_CREDIT_NOTE=
# ETIMS_PATH_DEBIT_NOTE=
# ETIMS_PATH_ITEM=
# ETIMS_QR_BASE_URL=
# ETIMS_RETRYABLE_RESULT_CODES=990,991,992,993,994,995,996,997,998,999

# M-Pesa STK Push: lets clients pay an invoice by approving a prompt on their phone (leave blank to disable)
#   Get the key, secret, shortcode and passkey from developer.safaricom.co.ke (Daraja).
#   MPESA_CALLBACK_TOKEN is any long random string you make up; it protects the confirmation URL.
#   Safaricom must be able to reach your site over https at NEXT_PUBLIC_APP_URL + /api/payments/mpesa/callback.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_TOKEN=
# Only if you receive money on a Buy Goods till; otherwise leave blank
MPESA_TILL_NUMBER=
# MPESA_CALLBACK_URL=

# Only for a third-party certified eTIMS integrator (leave ETIMS_MODE blank to use these)
KRA_ETIMS_API_URL=
KRA_ETIMS_API_TOKEN=
